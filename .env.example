# 复制为 .env 后按需修改。默认 mock 模式：无密钥、无网络，pytest 与演示均可运行。

# LLM 后端：mock（默认，规则式回复）| openai_compatible（需自备 Key）
LLM_PROVIDER=mock

# OpenAI 兼容配置（仅 provider=openai_compatible 时生效）
# 支持 OpenAI / DashScope / Kimi 等兼容 /chat/completions 的服务，示例：
#   DashScope: OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  OPENAI_MODEL=qwen-plus
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 可选：存储路径 / ReAct 循环上限 / 学期起点（用于“这周”计算）
# AGENT_DB_PATH=app/data/agent.db
# AGENT_MAX_ITERATIONS=5
# SEMESTER_START=2026-08-31
